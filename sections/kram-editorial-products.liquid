{% comment %}
  KRAMSAKON — Editorial products: story text + product grid beside one large
  lifestyle photograph (guideline §7.1.4–6, §8.3).

  Content model: an eyebrow/heading/intro and a small grid of real products
  (native Shopify collection, no custom data) sit in one column; a single
  large image via kram-image-mockup fills the other column. image_position
  controls which side the photograph sits on, the same idea as
  kram-story-block.

  Copy rule: truthful framings only — 'natural indigo', 'hand-dyed with
  natural indigo', 'handwoven'. Never 'chemical-free', 'no chemicals' or a
  '100% natural process'. No sale/discount/urgency content or settings.
{% endcomment %}

{{ 'kramsakon.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .kram-editorial {
    display: grid;
    grid-template-areas: "text" "media" "products";
    gap: var(--kram-space-md);
  }

  .kram-editorial__media {
    grid-area: media;
  }

  .kram-editorial__text {
    grid-area: text;
  }

  .kram-editorial__products {
    grid-area: products;
  }

  @media screen and (min-width: 990px) {
    .kram-editorial {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto 1fr;
      gap: var(--kram-space-lg);
    }

    .kram-editorial--image-left {
      grid-template-areas:
        "media text"
        "media products";
    }

    .kram-editorial--image-right {
      grid-template-areas:
        "text media"
        "products media";
    }

    .kram-editorial__text {
      align-self: start;
    }

    .kram-editorial__products {
      align-self: end;
    }

    /* The photograph spans both rows, so on desktop it takes its height from
       the text + product column beside it rather than from its own aspect
       ratio — that flush edge is what makes the block read as one composition
       instead of two stacked things. The ratio setting still governs mobile,
       where the image sits on its own. */
    .kram-editorial__media {
      align-self: stretch;
    }

    .kram-editorial__media > .kram-media {
      height: 100%;
      aspect-ratio: auto;
    }
  }

  .kram-editorial__intro {
    margin-top: var(--kram-space-sm);
  }

  .kram-editorial__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--kram-space-sm);
    list-style: none;
    margin: var(--kram-space-md) 0 0;
    padding: 0;
  }

  .kram-editorial__grid-item {
    margin: 0;
  }

  .kram-editorial__link {
    display: inline-block;
    margin-top: var(--kram-space-md);
    color: inherit;
    text-underline-offset: 0.5rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="kram-editorial kram-editorial--image-{{ section.settings.image_position }}">
      <div class="kram-editorial__media">
        {%- render 'kram-image-mockup',
          image: section.settings.image,
          ratio: section.settings.ratio,
          label: section.settings.image_label,
          alt: section.settings.image_alt,
          sizes: '(min-width: 990px) 50vw, 100vw'
        -%}
      </div>

      <div
        class="kram-editorial__text{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if section.settings.eyebrow != blank -%}
          <p class="kram-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <hr class="kram-rule" aria-hidden="true">
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <div class="rte kram-measure kram-lede kram-editorial__intro">{{ section.settings.intro }}</div>
        {%- endif -%}

        {%- comment -%}
          Both conditions matter: with a label but no collection chosen yet,
          collection.url is empty and the anchor would point at nothing.
        {%- endcomment -%}
        {%- if section.settings.link_label != blank and section.settings.collection != blank -%}
          <a href="{{ section.settings.collection.url }}" class="kram-editorial__link link">
            {{ section.settings.link_label | escape }}
          </a>
        {%- endif -%}
      </div>

      <div class="kram-editorial__products">
        {%- comment -%}
          Dawn's convention: the first card emits the shared component
          stylesheets, the rest skip them, so a grid does not repeat the same
          <link> tags per product.
        {%- endcomment -%}
        {%- assign skip_card_product_styles = false -%}
        <ul class="kram-editorial__grid" role="list">
          {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
            {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
              <li
                class="kram-editorial__grid-item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  show_secondary_image: true,
                  show_vendor: false,
                  show_rating: false,
                  skip_styles: skip_card_product_styles,
                  section_id: section.id,
                  quick_add: 'none'
                %}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..section.settings.products_to_show) -%}
              <li
                class="kram-editorial__grid-item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {% render 'card-product',
                  media_aspect_ratio: section.settings.image_ratio,
                  show_secondary_image: true,
                  show_vendor: false,
                  show_rating: false,
                  skip_styles: skip_card_product_styles,
                  section_id: section.id,
                  quick_add: 'none'
                %}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KRAM · Editorial products",
  "tag": "section",
  "class": "kram-section-editorial-products",
  "settings": [
    {
      "type": "paragraph",
      "content": "Story text and a small product grid beside one large photograph. Write truthfully: 'natural indigo', 'hand-dyed', 'handwoven' — never 'chemical-free' or '100% natural process'. No sale, discount or urgency content belongs in this section."
    },
    {
      "type": "header",
      "content": "Image [OWNER INPUT]"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph"
    },
    {
      "type": "text",
      "id": "image_label",
      "label": "Placeholder brief",
      "default": "Lifestyle photograph, natural daylight — pieces styled at home.",
      "info": "Shown in the empty placeholder to tell the owner what belongs here."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt text",
      "info": "Describe the photograph for screen readers and search. Translate per locale in Translate & Adapt."
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Photograph aspect ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image side (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The collection",
      "info": "Optional small label above the heading."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Woven for everyday"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Pieces dyed with natural indigo and woven by hand — made to be lived with.</p>"
    },
    {
      "type": "header",
      "content": "Products [OWNER INPUT]"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Choose the products to feature. Placeholder cards show until a collection is set."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 6,
      "step": 2,
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all",
      "info": "Optional. Links to the chosen collection. Shown only when this label is set."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "KRAM · Editorial products"
    }
  ]
}
{% endschema %}
