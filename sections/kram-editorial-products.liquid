{% comment %}
  KRAMSAKON — Editorial products: story text + product grid beside a large
  lifestyle photograph (guideline §7.1.4–6, §8.3).

  Content model: an eyebrow/heading/intro and a small grid of real products
  (native Shopify collection, no custom data) sit in one column; the other
  column is a lookbook — one photograph, or several rotating one at a time.
  image_position controls which side the lookbook sits on, the same idea as
  kram-story-block.

  The lookbook is built from blocks, and runs on Dawn's own
  <slideshow-component> (assets/global.js) so it inherits the theme's existing
  carousel behaviour rather than a hand-rolled one: scroll-snap, keyboard
  arrows and dots, autoplay that pauses on hover and focus, and a visible
  pause control. Its three markup requirements are easy to miss — the scroller
  must be id="Slider-…", each slide id="Slide-…", a .slider-buttons wrapper
  must exist or the component bails out of its constructor, and when autoplay
  is on a .slideshow__autoplay button must exist or setAutoPlay() reads an
  undefined this.reducedMotion and throws. See sections/kram-story-carousel.

  Products are deliberately NOT part of the lookbook: the grid always shows
  real catalog products (or neutral placeholders before a collection is
  picked), so nothing here interferes with catalog management.

  Copy rule: truthful framings only — 'natural indigo', 'hand-dyed with
  natural indigo', 'handwoven'. Never 'chemical-free', 'no chemicals' or a
  '100% natural process'. No sale/discount/urgency content or settings.
{% endcomment %}

{{ 'kramsakon.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .kram-editorial {
    display: grid;
    grid-template-areas: "text" "media" "products";
    gap: var(--kram-space-md);
  }

  .kram-editorial__media {
    grid-area: media;
  }

  .kram-editorial__text {
    grid-area: text;
  }

  .kram-editorial__products {
    grid-area: products;
  }

  @media screen and (min-width: 990px) {
    .kram-editorial {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto 1fr;
      gap: var(--kram-space-lg);
    }

    .kram-editorial--image-left {
      grid-template-areas:
        "media text"
        "media products";
    }

    .kram-editorial--image-right {
      grid-template-areas:
        "text media"
        "products media";
    }

    .kram-editorial__text {
      align-self: start;
    }

    .kram-editorial__products {
      align-self: end;
    }

    /* The lookbook spans both rows and keeps its own aspect ratio rather than
       stretching to the column beside it. A single fixed image could safely be
       stretched and cover-cropped; a rotating one cannot — these are full-
       length figures, and a crop deep enough to match an arbitrary column
       height takes the head or the feet off the model. */
    .kram-editorial__media {
      align-self: start;
    }
  }

  .kram-editorial__gallery-slide {
    flex: 0 0 100%;
    width: 100%;
  }

  #Slider-{{ section.id }} {
    display: flex;
    align-items: stretch;
  }

  .kram-editorial__gallery-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }

  /* Dawn parks the autoplay button absolutely inside its banner; here the
     controls are a plain centred row under the photograph. */
  .kram-editorial__gallery-controls .slideshow__autoplay {
    position: static;
    width: 4.4rem;
    height: 4.4rem;
  }

  @media (prefers-reduced-motion: reduce) {
    #Slider-{{ section.id }} {
      scroll-behavior: auto;
    }
  }

  .kram-editorial__intro {
    margin-top: var(--kram-space-sm);
  }

  .kram-editorial__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--kram-space-sm);
    list-style: none;
    margin: var(--kram-space-md) 0 0;
    padding: 0;
  }

  .kram-editorial__grid-item {
    margin: 0;
  }

  .kram-editorial__link {
    display: inline-block;
    margin-top: var(--kram-space-md);
    color: inherit;
    text-underline-offset: 0.5rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="kram-editorial kram-editorial--image-{{ section.settings.image_position }}">
      <div class="kram-editorial__media">
        {%- if section.blocks.size > 0 -%}
          <slideshow-component
            class="kram-editorial__gallery"
            role="region"
            aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
            aria-label="{{ section.settings.gallery_label | escape }}"
          >
            {%- comment -%}
              aria-live and aria-atomic belong on the scroller: the component
              marks every off-screen slide aria-hidden, so only the photograph
              on show is announced. Same arrangement as Dawn's own slideshow.
            {%- endcomment -%}
            <div
              id="Slider-{{ section.id }}"
              class="kram-editorial__gallery-track slider slider--everywhere"
              aria-live="polite"
              aria-atomic="true"
              data-autoplay="{{ section.settings.auto_rotate }}"
              data-speed="{{ section.settings.change_slides_speed }}"
            >
              {%- for block in section.blocks -%}
                <div
                  id="Slide-{{ section.id }}-{{ forloop.index }}"
                  class="kram-editorial__gallery-slide slideshow__slide slider__slide"
                  role="group"
                  aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                  aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                  {{ block.shopify_attributes }}
                >
                  {%- liquid
                    comment
                      'none' is the select's off value — passing it straight
                      through would ask asset_url for a file called 'none'.
                    endcomment
                    assign bundled = block.settings.bundled_image
                    if bundled == 'none'
                      assign bundled = ''
                    endif
                  -%}
                  {%- render 'kram-image-mockup',
                    image: block.settings.image,
                    asset: bundled,
                    ratio: section.settings.ratio,
                    label: block.settings.image_label,
                    alt: block.settings.image_alt,
                    sizes: '(min-width: 990px) 50vw, 100vw'
                  -%}
                </div>
              {%- endfor -%}
            </div>

            {%- comment -%}
              A single photograph is not a slideshow — controls under it would
              be dead arrows.
            {%- endcomment -%}
            {%- if section.blocks.size > 1 -%}
              <div class="kram-editorial__gallery-controls slider-buttons">
                <button
                  type="button"
                  class="slider-button slider-button--prev"
                  name="previous"
                  aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
                  aria-controls="Slider-{{ section.id }}"
                >
                  <span class="svg-wrapper">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </button>

                <div class="slider-counter slider-counter--dots">
                  <div class="slideshow__control-wrapper">
                    {%- for block in section.blocks -%}
                      <button
                        type="button"
                        class="slider-counter__link slider-counter__link--dots link"
                        aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                        aria-controls="Slider-{{ section.id }}"
                      >
                        <span class="dot"></span>
                      </button>
                    {%- endfor -%}
                  </div>
                </div>

                <button
                  type="button"
                  class="slider-button slider-button--next"
                  name="next"
                  aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
                  aria-controls="Slider-{{ section.id }}"
                >
                  <span class="svg-wrapper">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </button>

                {%- if section.settings.auto_rotate -%}
                  <button
                    type="button"
                    class="slideshow__autoplay slider-button"
                    aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-pause.svg' | inline_asset_content -}}
                    </span>
                    <span class="svg-wrapper">
                      {{- 'icon-play.svg' | inline_asset_content -}}
                    </span>
                  </button>
                {%- endif -%}
              </div>
            {%- endif -%}
          </slideshow-component>
        {%- else -%}
          {%- comment -%}
            Every photograph block removed — keep the frame so the column does
            not collapse and the editor still shows what belongs here.
          {%- endcomment -%}
          {%- render 'kram-image-mockup',
            ratio: section.settings.ratio,
            label: section.settings.image_label,
            sizes: '(min-width: 990px) 50vw, 100vw'
          -%}
        {%- endif -%}
      </div>

      <div
        class="kram-editorial__text{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if section.settings.eyebrow != blank -%}
          <p class="kram-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <hr class="kram-rule" aria-hidden="true">
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <div class="rte kram-measure kram-lede kram-editorial__intro">{{ section.settings.intro }}</div>
        {%- endif -%}

        {%- comment -%}
          Both conditions matter: with a label but no collection chosen yet,
          collection.url is empty and the anchor would point at nothing.
        {%- endcomment -%}
        {%- if section.settings.link_label != blank and section.settings.collection != blank -%}
          <a href="{{ section.settings.collection.url }}" class="kram-editorial__link link">
            {{ section.settings.link_label | escape }}
          </a>
        {%- endif -%}
      </div>

      <div class="kram-editorial__products">
        {%- comment -%}
          Dawn's convention: the first card emits the shared component
          stylesheets, the rest skip them, so a grid does not repeat the same
          <link> tags per product.
        {%- endcomment -%}
        {%- assign skip_card_product_styles = false -%}
        <ul class="kram-editorial__grid" role="list">
          {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
            {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
              <li
                class="kram-editorial__grid-item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  show_secondary_image: true,
                  show_vendor: false,
                  show_rating: false,
                  skip_styles: skip_card_product_styles,
                  section_id: section.id,
                  quick_add: 'none'
                %}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..section.settings.products_to_show) -%}
              <li
                class="kram-editorial__grid-item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {% render 'card-product',
                  media_aspect_ratio: section.settings.image_ratio,
                  show_secondary_image: true,
                  show_vendor: false,
                  show_rating: false,
                  skip_styles: skip_card_product_styles,
                  section_id: section.id,
                  quick_add: 'none'
                %}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KRAM · Editorial products",
  "tag": "section",
  "class": "kram-section-editorial-products",
  "settings": [
    {
      "type": "paragraph",
      "content": "Story text and a small product grid beside a lookbook. Add a Photograph block per shot — several rotate one at a time. Write truthfully: 'natural indigo', 'hand-dyed', 'handwoven' — never 'chemical-free' or '100% natural process'. No sale, discount or urgency content belongs in this section."
    },
    {
      "type": "header",
      "content": "Lookbook"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Photograph aspect ratio",
      "options": [
        { "value": "3 / 5", "label": "Tall portrait (3:5)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "3 / 5",
      "info": "Shared by every photograph so the lookbook does not change height as it rotates. Anything that does not match this shape is cropped from the centre — for full-length figures, 3:5 is the safe choice."
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Rotate automatically",
      "default": true,
      "info": "Only applies with more than one photograph. A pause button is shown alongside the arrows so the rotation can be stopped."
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "label": "Change photograph every",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5,
      "info": "Rotation also pauses on hover and while the lookbook has keyboard focus."
    },
    {
      "type": "text",
      "id": "gallery_label",
      "label": "Lookbook description",
      "default": "The collection, worn",
      "info": "Announced by screen readers to introduce the rotating photographs."
    },
    {
      "type": "text",
      "id": "image_label",
      "label": "Empty-state brief",
      "default": "Lifestyle photograph, natural daylight — pieces styled at home.",
      "info": "Shown only if every photograph block is removed."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Lookbook side (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The collection",
      "info": "Optional small label above the heading."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Woven for everyday"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Pieces dyed with natural indigo and woven by hand — made to be lived with.</p>"
    },
    {
      "type": "header",
      "content": "Products [OWNER INPUT]"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Choose the products to feature. Placeholder cards show until a collection is set."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 6,
      "step": 2,
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all",
      "info": "Optional. Links to the chosen collection. Shown only when this label is set."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "model",
      "name": "Photograph",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photograph",
          "info": "Your own image, uploaded to Content → Files. Takes priority over the bundled lookbook shot below and gets a full responsive srcset, so prefer it once final photography exists."
        },
        {
          "type": "select",
          "id": "bundled_image",
          "label": "Bundled lookbook shot",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "kram-model-01a.jpg", "label": "Look 1 — draped cloth" },
            { "value": "kram-model-01b.jpg", "label": "Look 1 — striped dress" },
            { "value": "kram-model-02a.jpg", "label": "Look 2 — shirt and tote" },
            { "value": "kram-model-02b.jpg", "label": "Look 2 — indigo jacket" },
            { "value": "kram-model-03a.jpg", "label": "Look 3 — striped shirtdress" },
            { "value": "kram-model-03b.jpg", "label": "Look 3 — long coat" }
          ],
          "default": "none",
          "info": "Lookbook photographs that ship with the theme (630 × 1043). Used only when nothing is uploaded above."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt text",
          "info": "Describe the photograph for screen readers and search."
        },
        {
          "type": "text",
          "id": "image_label",
          "label": "Placeholder brief",
          "default": "Lookbook photograph, natural daylight — the pieces worn.",
          "info": "Shown in the empty placeholder when neither an upload nor a bundled shot is set."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KRAM · Editorial products",
      "blocks": [{ "type": "model" }]
    }
  ]
}
{% endschema %}
