{% comment %}
  KRAMSAKON — Brand-essence strip (guideline §7.1.3, §8.3).

  One quiet line that names the three things the brand stands on — natural
  indigo, handcraft, community — and hands the reader on to Our Story.
  It is a statement, never an offer.
{% endcomment %}

{{ 'kramsakon.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.text != blank -%}
  <div class="kram-essence color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <p
        class="kram-essence__text{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {{ section.settings.text | escape }}
      </p>

      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a
          href="{{ section.settings.link }}"
          class="kram-essence__link link{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: 2;"
          {% endif %}
        >
          {{ section.settings.link_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "KRAM · Brand essence",
  "tag": "section",
  "class": "kram-section-essence",
  "settings": [
    {
      "type": "paragraph",
      "content": "One line on natural indigo, handcraft and community, leading into Our Story. Keep it factual — this is not a promotional slot."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Statement",
      "default": "Premium textiles, dyed with natural indigo and woven by hand — created by a community of makers in Sakon Nakhon."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "KRAM · Brand essence"
    }
  ]
}
{% endschema %}
