{% comment %}
  KRAMSAKON — Contact (guideline §7.5, §8.3).

  Contact form → the store owner's inbox, alongside the contact details and an
  embedded map. Details are read from Theme settings → "KRAMSAKON — brand &
  contact" so they exist in exactly one place and feed the footer and the
  Organization structured data too.

  The phone number is [OWNER INPUT — confirm]. While the setting is blank the
  page says so plainly rather than publishing a number that may be wrong.
{% endcomment %}

{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
{{ 'kramsakon.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show_social -%}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign address_parts = ''
  if settings.kram_address_street != blank
    assign address_parts = address_parts | append: settings.kram_address_street | append: '||'
  endif
  if settings.kram_address_locality != blank
    assign address_parts = address_parts | append: settings.kram_address_locality | append: '||'
  endif
  if settings.kram_address_region != blank
    assign region_line = settings.kram_address_region | append: ' ' | append: settings.kram_address_postal | strip
    assign address_parts = address_parts | append: region_line | append: '||'
  endif
  assign address_lines = address_parts | split: '||'

  assign contact_form_class = 'isolate kram-contact__form'
  if settings.animations_reveal_on_scroll
    assign contact_form_class = 'isolate kram-contact__form scroll-trigger animate--slide-in'
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div
        class="kram-measure{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if section.settings.heading != blank -%}
          <h1 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="rte kram-lede">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="kram-contact">
      {%- comment -%} Column 1 — the form {%- endcomment -%}
      <div>
        {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
          {%- if form.posted_successfully? -%}
            <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.post_success' | t }}
            </h2>
          {%- elsif form.errors -%}
            <div class="form__message">
              <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                {{- 'icon-error.svg' | inline_asset_content -}}
                {{ 'templates.contact.form.error_heading' | t }}
              </h2>
            </div>
            <ul class="form-status-list caption-large" role="list">
              <li>
                <a href="#ContactForm-email" class="link">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </a>
              </li>
            </ul>
          {%- endif -%}

          <div class="field">
            <input
              class="field__input"
              autocomplete="name"
              type="text"
              id="ContactForm-name"
              name="contact[{{ 'templates.contact.form.name' | t }}]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="{{ 'templates.contact.form.name' | t }}"
            >
            <label class="field__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
          </div>

          <div class="field field--with-error">
            <input
              autocomplete="email"
              type="email"
              id="ContactForm-email"
              class="field__input"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
              placeholder="{{ 'templates.contact.form.email' | t }}"
            >
            <label class="field__label" for="ContactForm-email">
              {{- 'templates.contact.form.email' | t }}
              <span aria-hidden="true">*</span></label
            >
            {%- if form.errors contains 'email' -%}
              <small class="contact__field-error" id="ContactForm-email-error">
                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                <span class="form__message">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </span>
              </small>
            {%- endif -%}
          </div>

          {%- if section.settings.show_phone_field -%}
            <div class="field">
              <input
                type="tel"
                id="ContactForm-phone"
                class="field__input"
                autocomplete="tel"
                name="contact[{{ 'templates.contact.form.phone' | t }}]"
                pattern="[0-9\-\+\s]*"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="{{ 'templates.contact.form.phone' | t }}"
              >
              <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
            </div>
          {%- endif -%}

          <div class="field">
            <textarea
              rows="8"
              id="ContactForm-body"
              class="text-area field__input"
              name="contact[{{ 'templates.contact.form.comment' | t }}]"
              placeholder="{{ 'templates.contact.form.comment' | t }}"
            >{{ form.body }}</textarea>
            <label class="form__label field__label" for="ContactForm-body">
              {{- 'templates.contact.form.comment' | t -}}
            </label>
          </div>

          <div class="contact__button">
            <button type="submit" class="button">
              {{ 'templates.contact.form.send' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>

      {%- comment -%} Column 2 — details, socials, map {%- endcomment -%}
      <div>
        {%- if section.settings.details_heading != blank -%}
          <h2 class="h4">{{ section.settings.details_heading | escape }}</h2>
        {%- endif -%}

        <ul class="kram-contact__details" role="list">
          {%- if address_lines.size > 0 -%}
            <li class="kram-contact__detail">
              <span class="kram-contact__detail-label">{{ 'kramsakon.contact.address' | t }}</span>
              <address class="kram-contact__detail-value">
                {%- for line in address_lines -%}
                  {{ line }}{% unless forloop.last %}<br>{% endunless %}
                {%- endfor -%}
              </address>
            </li>
          {%- endif -%}

          <li class="kram-contact__detail">
            <span class="kram-contact__detail-label">{{ 'kramsakon.contact.phone' | t }}</span>
            <span class="kram-contact__detail-value">
              {%- if settings.kram_phone != blank -%}
                <a href="tel:{{ settings.kram_phone | remove: ' ' | remove: '-' }}">{{ settings.kram_phone }}</a>
              {%- else -%}
                <span class="kram-contact__pending">{{ 'kramsakon.contact.phone_pending' | t }}</span>
              {%- endif -%}
            </span>
          </li>

          {%- if settings.kram_line_id != blank -%}
            <li class="kram-contact__detail">
              <span class="kram-contact__detail-label">{{ 'kramsakon.contact.line' | t }}</span>
              <span class="kram-contact__detail-value">
                {%- if section.settings.line_url != blank -%}
                  <a href="{{ section.settings.line_url }}" target="_blank" rel="noopener">
                    {{- settings.kram_line_id -}}
                  </a>
                {%- else -%}
                  {{ settings.kram_line_id }}
                {%- endif -%}
              </span>
            </li>
          {%- endif -%}

          {%- if settings.kram_email != blank -%}
            <li class="kram-contact__detail">
              <span class="kram-contact__detail-label">{{ 'kramsakon.contact.email' | t }}</span>
              <span class="kram-contact__detail-value">
                <a href="mailto:{{ settings.kram_email }}">{{ settings.kram_email }}</a>
              </span>
            </li>
          {%- endif -%}

          {%- if settings.kram_hours != blank -%}
            <li class="kram-contact__detail">
              <span class="kram-contact__detail-label">{{ 'kramsakon.contact.hours' | t }}</span>
              <span class="kram-contact__detail-value">{{ settings.kram_hours }}</span>
            </li>
          {%- endif -%}
        </ul>

        {%- if section.settings.show_social -%}
          {%- render 'social-icons' -%}
        {%- endif -%}

        {%- if settings.kram_map_embed_src != blank -%}
          <div class="kram-contact__map kram-contact__map--ratio">
            <iframe
              src="{{ settings.kram_map_embed_src }}"
              title="{{ 'kramsakon.contact.map_title' | t }}"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
        {%- else -%}
          <div class="kram-contact__map kram-contact__map--ratio kram-media">
            <div class="kram-placeholder" aria-hidden="true">
              <span class="kram-placeholder__tag">[OWNER INPUT] — Map</span>
              <p class="kram-placeholder__label">
                Add the Google Maps embed URL in Theme settings → KRAMSAKON — brand &amp; contact.
              </p>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KRAM · Contact",
  "tag": "section",
  "class": "kram-section-contact",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Address, phone, LINE, hours and the map are read from Theme settings → \"KRAMSAKON — brand & contact\" so they stay consistent across the site. Edit them there, not here."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>We'd love to hear from you. For product enquiries or to visit us, reach out below.</p>"
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "Details heading",
      "default": "Find us"
    },
    {
      "type": "checkbox",
      "id": "show_phone_field",
      "label": "Show a phone field in the form",
      "default": false,
      "info": "The brief specifies name, email and message only. Turn on if the owner wants a phone number from enquirers."
    },
    {
      "type": "url",
      "id": "line_url",
      "label": "LINE link",
      "info": "[OWNER INPUT] Optional. e.g. https://line.me/R/ti/p/@kramsakon1 — makes the LINE ID tappable on mobile."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true,
      "info": "Social links are set in Theme settings → Social media. Icons only appear for links that are filled in."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "KRAM · Contact"
    }
  ]
}
{% endschema %}
