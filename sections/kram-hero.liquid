{% comment %}
  KRAMSAKON — Story hero (guideline §7.1.2, §8.3).

  A large, calm, full-bleed opener. Image is an owner-filled mockup slot.
  Two layouts: text over the photograph, or text set beneath it — the second
  is the safe choice when the owner's final image is light or busy, because it
  keeps text contrast independent of the photo (§8.5, accessibility).
{% endcomment %}

{{ 'kramsakon.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .kram-hero {
    --kram-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --kram-ratio: {{ section.settings.ratio_mobile }};
    --kram-ratio-desktop: {{ section.settings.ratio_desktop }};
  }

  #shopify-section-{{ section.id }} .kram-hero__content {
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .kram-hero__content {
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="kram-hero kram-hero--{{ section.settings.layout }} color-{{ section.settings.color_scheme }} gradient">
  <div class="kram-hero__media">
    {%- render 'kram-image-mockup',
      image: section.settings.image,
      ratio: section.settings.ratio_desktop,
      label: section.settings.image_label,
      alt: section.settings.image_alt,
      sizes: '100vw',
      loading: 'eager',
      preload: true
    -%}
  </div>

  {%- if section.settings.layout == 'overlay' -%}
    <div class="kram-hero__overlay"></div>
  {%- endif -%}

  <div class="kram-hero__content{% if section.settings.layout == 'text-below' %} page-width{% endif %}">
    {%- comment -%}
      Heading level, not size — visual size stays on the class.

      On the homepage Dawn wraps the header logo in the page's <h1>, so the
      hero steps down to <h2> to avoid two first-level headings. The header
      always renders a logo (uploaded, or the wordmark bundled at
      assets/kram-logo.png), so that <h1> is always there. On any other page
      the hero headline IS the page's first-level heading — without this the
      page would ship with no <h1> at all.
    {%- endcomment -%}
    {%- liquid
      assign heading_tag = 'h1'
      if request.page_type == 'index'
        assign heading_tag = 'h2'
      endif
    -%}
    {%- if section.settings.heading != blank -%}
      <{{ heading_tag }} class="kram-hero__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading | escape }}
      </{{ heading_tag }}>
    {%- endif -%}

    {%- if section.settings.tagline != blank -%}
      <p class="kram-hero__tagline">{{ section.settings.tagline | escape }}</p>
    {%- endif -%}

    {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
      <div class="kram-hero__actions">
        {%- if section.settings.button_label_1 != blank -%}
          <a
            href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}"
            class="button"
          >
            {{ section.settings.button_label_1 | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a
            href="{{ section.settings.button_link_2 | default: routes.root_url }}"
            class="button button--secondary"
          >
            {{ section.settings.button_label_2 | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "KRAM · Hero",
  "tag": "section",
  "class": "kram-section-hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "The store's opening image. Keep the headline short and honest — no superlatives, no offers."
    },
    {
      "type": "header",
      "content": "Image [OWNER INPUT]"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "image_label",
      "label": "Placeholder brief",
      "default": "Indigo-dyed cloth or an indigo vat, natural daylight, full-bleed.",
      "info": "Shown in the empty placeholder to tell the owner what belongs here. Disappears once an image is added."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt text",
      "default": "Naturally indigo-dyed cloth from Sakon Nakhon",
      "info": "Describe the photograph. Translate per locale in Translate & Adapt."
    },
    {
      "type": "select",
      "id": "ratio_desktop",
      "label": "Desktop aspect ratio",
      "options": [
        { "value": "16 / 7", "label": "Cinematic (16:7)" },
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "3 / 2", "label": "Classic (3:2)" },
        { "value": "2 / 1", "label": "Panoramic (2:1)" }
      ],
      "default": "16 / 7"
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "Mobile aspect ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Text placement",
      "options": [
        { "value": "overlay", "label": "Over the image" },
        { "value": "text-below", "label": "Below the image" }
      ],
      "default": "overlay",
      "info": "Choose 'Below the image' if the final photograph is light or busy — text contrast then no longer depends on the photo."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image darkening",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 35,
      "info": "Only applies when text sits over the image. Keep enough to hold WCAG contrast on the headline."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1",
      "info": "Applies when text is set below the image."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Naturally dyed by hand, in Sakon Nakhon."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Headline size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h0"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Learning from Nature. Creating the Future."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding inside the hero",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "KRAM · Hero"
    }
  ]
}
{% endschema %}
