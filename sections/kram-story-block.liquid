{% comment %}
  KRAMSAKON — Story block: image + text (guideline §7.1.4–6, §8.3).

  The workhorse of the editorial layout. Repeat it down the homepage and the
  Our Story page, alternating the image side, so story and product interleave
  rather than sitting in separate silos.

  Also does duty as a full-bleed image band (layout = "band"), which is the
  same content model with the text removed.
{% endcomment %}

{{ 'kramsakon.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  comment
    'none' is the select's off value — passing it straight through would ask
    asset_url for a file called 'none'.
  endcomment
  assign bundled = section.settings.bundled_image
  if bundled == 'none'
    assign bundled = ''
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="
      {% if section.settings.width == 'full' %}kram-section--flush{% else %}page-width{% endif %}
      section-{{ section.id }}-padding
    "
  >
    <div
      class="
        kram-story kram-story--image-{{ section.settings.image_position }}
        {%- if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}
      "
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
      {% endif %}
    >
      <div class="kram-story__media">
        {%- render 'kram-image-mockup',
          image: section.settings.image,
          asset: bundled,
          ratio: section.settings.ratio,
          label: section.settings.image_label,
          alt: section.settings.image_alt,
          sizes: '(min-width: 990px) 50vw, 100vw'
        -%}
      </div>

      <div class="kram-story__body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="kram-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <hr class="kram-rule" aria-hidden="true">
          <h2 class="kram-story__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="kram-story__link link">
            {{ section.settings.link_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KRAM · Story block",
  "tag": "section",
  "class": "kram-section-story",
  "settings": [
    {
      "type": "paragraph",
      "content": "Image beside text. Alternate the image side between consecutive blocks so the page reads as an editorial rhythm. Write truthfully: 'natural indigo', 'hand-dyed', 'handwoven' — never 'chemical-free' or '100% natural process'."
    },
    {
      "type": "header",
      "content": "Image [OWNER INPUT]"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Your own upload from Content → Files. Takes priority over the bundled photograph below and gets a full responsive srcset, so prefer it."
    },
    {
      "type": "select",
      "id": "bundled_image",
      "label": "Bundled photograph",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "kram-founder.jpg", "label": "The founder, hanging cloth (3:2)" },
        { "value": "kram-story-plant.jpg", "label": "Indigo seedlings (3:2)" },
        { "value": "kram-story-vat.jpg", "label": "Dyeing at the vats (3:2)" },
        { "value": "kram-story-loom.jpg", "label": "Weaving at the loom (3:2)" },
        { "value": "kram-story-thread.jpg", "label": "Winding the thread (3:2)" },
        { "value": "kram-portrait-plant.jpg", "label": "Indigo seedlings (4:5)" },
        { "value": "kram-portrait-cloth.jpg", "label": "Handwoven cloth (4:5)" },
        { "value": "kram-portrait-loom.jpg", "label": "Weaving at the loom (4:5)" }
      ],
      "default": "none",
      "info": "Photographs that ship with the theme. Match the crop in brackets to the aspect ratio set below, or the frame will crop it further."
    },
    {
      "type": "text",
      "id": "image_label",
      "label": "Placeholder brief",
      "default": "Hands at work, indigo vat, or close-up weave — natural daylight.",
      "info": "Shown in the empty placeholder to tell the owner what belongs here."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt text",
      "info": "Describe the photograph for screen readers and search."
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "21 / 9", "label": "Panoramic (21:9)" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image side (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional small label above the heading."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the indigo plant"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body",
      "default": "<p>Our colour comes from the indigo plant — a natural dye at the heart of a craft passed down for generations in Sakon Nakhon. Every piece is dyed by hand, so no two are exactly alike.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "info": "Optional. The link only renders when both a label and a link are set."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full bleed" }
      ],
      "default": "page"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "KRAM · Story block"
    }
  ]
}
{% endschema %}
