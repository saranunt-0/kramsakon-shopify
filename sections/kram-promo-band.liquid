{% comment %}
  KRAMSAKON — Configurable, empty-by-default promo band (guideline §11, §8.6).

  This slot exists so the owner can insert their own announcements
  personally. It ships with every setting blank and must render absolutely
  nothing — no wrapper, no padding, no border — until the owner fills it in.
  The theme itself must never auto-populate this with shipping offers,
  discounts, or countdowns (guideline §2.2.3).

  Note on the schema below: none of the text settings carry a "default" key.
  Shopify rejects `"default": ""` outright ("default can't be blank"), and any
  non-blank default would make this band render out of the box — the opposite
  of what §11 requires. Omitting the key entirely is what leaves the slot
  genuinely empty. Do not add defaults here.
{% endcomment %}

{{ 'kramsakon.css' | asset_url | stylesheet_tag }}

{%- if section.settings.heading != blank or section.settings.text != blank or section.settings.button_label != blank -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div
        class="{% if section.settings.text_alignment == 'center' %}kram-center {% endif %}kram-measure{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="button"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "KRAM · Promo band",
  "tag": "section",
  "class": "kram-section-promo-band",
  "settings": [
    {
      "type": "paragraph",
      "content": "Empty by default and renders nothing until you fill it in. Use this for your own announcements. The theme will never add shipping offers, discounts or countdowns for you."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "KRAM · Promo band"
    }
  ]
}
{% endschema %}
