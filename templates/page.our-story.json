    "social_enterprise": {
      "type": "kram-story-block",
      "settings": {
        "bundled_image": "kram-story-vat.jpg",
        "image_label": "The community benefiting from the craft — workshop, market, or makers together.",
        "image_alt": "A dyer lifting a hank of yarn from a natural indigo vat",
        "ratio": "3 / 2",
        "image_position": "right",
        "eyebrow": "Social enterprise",
        "heading": "A social enterprise",
        "heading_size": "h2",
        "text": "<p>KRAMSAKON is a social enterprise. We help the value of this craft flow back to the community of makers — creating income, opportunity, and an economy that grows together with Sakon Nakhon.</p><p>Today KRAMSAKON is more than an indigo clothing store. It is a meeting point between local wisdom, natural materials, scientific knowledge, design, and contemporary commerce — helping turn Sakon Nakhon’s traditional blue into a living craft that can keep evolving without losing its connection to the land and the people who make it.</p>",
        "link_label": "",
        "link": "",
