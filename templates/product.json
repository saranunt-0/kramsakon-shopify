{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "square"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "variation_note": {
          "type": "kram_variation_note",
          "settings": {
            "content": "<p>Each piece is dyed and woven by hand with natural indigo, so slight differences in colour and pattern are natural — and make your piece uniquely yours.</p>"
          }
        },
        "materials": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Materials & natural indigo",
            "icon": "none",
            "content": "<p>Dyed with natural indigo. Add the fibre and weight for this piece — for example, 100% cotton, handwoven.</p>"
          }
        },
        "craft": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Handcraft & origin",
            "icon": "none",
            "content": "<p>Hand-dyed with natural indigo and woven by hand by the community of makers in Sakon Nakhon, Thailand.</p>"
          }
        },
        "care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care",
            "icon": "none",
            "content": "<p>[OWNER INPUT] Add washing and care instructions for this piece.</p>"
          }
        },
        "dimensions": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Dimensions",
            "icon": "none",
            "content": "<p>[OWNER INPUT] Add the measurements for this piece.</p>"
          }
        },
        "shipping_returns": {
          "type": "popup",
          "settings": {
            "text": "Shipping & returns"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "variation_note",
        "materials",
        "craft",
        "care",
        "dimensions",
        "shipping_returns",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 48,
        "padding_bottom": 24
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 24,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 72,
        "padding_bottom": 72
      }
    }
  },
  "order": ["main", "disclosures", "related-products"]
}
